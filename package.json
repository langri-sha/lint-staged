{
  "name": "@langri-sha/lint-staged",
  "version": "0.9.8",
  "description": "Shared lint-staged config that runs ESLint and Prettier before each commit",
  "keywords": [
    "eslint",
    "husky",
    "lint-staged",
    "prettier"
  ],
  "homepage": "https://github.com/langri-sha/lint-staged#readme",
  "bugs": {
    "url": "https://github.com/langri-sha/lint-staged/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/langri-sha/lint-staged.git"
  },
  "license": "MIT",
  "author": {
    "name": "Filip Dupanović",
    "email": "filip.dupanovic@gmail.com",
    "url": "https://langri-sha.com",
    "organization": false
  },
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "change": "pnpm exec projen change",
    "default": "pnpm exec projen default",
    "prepare": "husky",
    "prepublishOnly": "rm -rf dist; tsc --project tsconfig.build.json",
    "renovate": "pnpm exec projen renovate"
  },
  "devDependencies": {
    "@langri-sha/eslint-config": "0.9.17",
    "@langri-sha/prettier": "0.4.9",
    "@langri-sha/projen-project": "0.31.2",
    "@langri-sha/tsconfig": "1.1.0",
    "beachball": "2.66.0",
    "eslint": "10.11.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.9",
    "projen": "0.86.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "eslint": "^10.4.0",
    "lint-staged": "^17.0.0",
    "prettier": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    },
    "prettier": {
      "optional": true
    }
  },
  "packageManager": "pnpm@12.8.1",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">= 24.16.0"
    }
  },
  "publishConfig": {
    "access": "public",
    "main": "dist/index.js",
    "types": "dist/index.d.ts"
  },
  "//": "~~ Generated by projen. To modify, edit .projenrc.ts and run \"pnpm exec projen\"."
}
